# Variables de entorno del proyecto.
#
# NUNCA se copian a un archivo .env dentro del repositorio: se configuran en
# Vercel (Project Settings → Environment Variables) y, para trabajar en local,
# se escriben en .env.local (ese archivo está en .gitignore).

# ─── Acceso al panel ─────────────────────────────────────────────────────────
# Usuario y contraseña, sin más. Se escriben tal cual y se pueden cambiar desde
# el panel de Vercel en cualquier momento. ADMIN_NAME es solo el nombre que se
# muestra dentro del panel.
ADMIN_USER=miguel
ADMIN_NAME=Miguel
ADMIN_PASSWORD=una-contraseña-larga-y-tuya

# Alternativa para varias cuentas: array JSON en UNA sola línea. El campo
# "password" admite texto plano o un hash generado con `npm run credenciales`.
# ADMIN_USERS=[{"username":"miguel","name":"Miguel","password":"..."},{"username":"tienda","name":"Tienda","password":"..."}]

# ─── Cotización de metales ───────────────────────────────────────────────────
# Clave de goldapi.io. Solo la usa la función del servidor: no llega al navegador.
GOLDAPI_KEY=goldapi-xxxxxxxxxxxx-io

# ─── Almacenamiento (Upstash Redis) ──────────────────────────────────────────
# Las inyecta automáticamente la integración de Upstash del Marketplace de
# Vercel. Solo hay que definirlas a mano si se provisiona la base por fuera.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# ─── Documentos del portal de clientes (Vercel Blob) ─────────────────────────
# La inyecta la integración de Blob al vincularla con el proyecto:
# Vercel → Storage → Create Database → Blob. Los documentos se guardan con
# acceso privado y solo se leen desde el panel.
#
# Sin esta variable, el portal guarda los documentos en el almacén en memoria
# (solo en local, para poder probar el circuito); en Vercel, la subida avisa de
# que falta configurar el almacén en lugar de improvisar.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ─── Cliente de prueba del portal (solo en local) ────────────────────────────
# Correo y contraseña, separados por dos puntos. Con esto puesto, el servidor
# de desarrollo crea esa cuenta de cliente YA APROBADA cada vez que arranca, sin
# tener que ejecutar `npm run demo`. El almacén en local vive en memoria, así
# que cada reinicio se lleva las cuentas por delante: esto las repone.
#
# En Vercel no hace nada: la acción que la crea solo responde en local.
# CLIENTE_DEMO=correo@tienda.es:contraseña

# ─── Correo saliente (opcional) ──────────────────────────────────────────────
# Solo se usa para una cosa: mandarle al cliente el enlace para elegir
# contraseña nueva cuando la olvida. Sin esto configurado, el portal sigue
# funcionando igual: la solicitud queda marcada en la ficha del cliente y TQM
# genera el código desde el panel y se lo da por teléfono.
#
# El remitente tiene que ser de un dominio verificado en el proveedor.
# RESEND_API_KEY=re_xxxxxxxx
# CORREO_DESDE=Te Quiero Metales <no-responder@tudominio.com>
